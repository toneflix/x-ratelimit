# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# addons.mozilla.org API credentials, used by `npm run sign:firefox`.
# Create them at https://addons.mozilla.org/developers/addon/api/key/
WEB_EXT_API_KEY=user:00000000:000
WEB_EXT_API_SECRET=

# Optional: build only these browsers (comma-separated: chrome, firefox,
# safari). Unset builds all three. The build:<browser> scripts override it.
# TARGET=chrome

# Optional: sub-path the website is served from, e.g. /x-ratelimit/ for a
# GitHub Pages project site. Unset means /. CI sets it automatically.
# BASE=/x-ratelimit/
